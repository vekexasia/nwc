# Copy to .env and fill in real values. .env is gitignored and never committed.
# Tracked docs and scripts use these placeholders: YOUR_GAMING_HOST, YOUR_CLIENT_IP.
NW_GAMING_HOST=        # public address of the streaming/capture host
NW_SSH_CONTROL=        # local path to the SSH control socket used for the master
NW_SSH_HOST_KEY_SHA256= # SSH host key fingerprint accepted via TOFU
NW_CLIENT_PUBLIC_IP=   # client public IPv4 allowed through the host firewall
